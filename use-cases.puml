@startuml
left to right direction

actor Member
actor Librarian
actor "Mail server" as Mail <<system>>

rectangle "Library System" {
  usecase "Borrow book" as Borrow
  usecase "Renew loan" as Renew
  usecase "Reserve book" as Reserve
  usecase "Return book" as Return
}

Member -- Borrow
Member -- Renew
Member -- Reserve

Librarian -- Borrow
Librarian -- Return

Reserve -- Mail
@enduml
